{
  "name": "ai-due-diligence-assistant",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI due-diligence assistant: cited-source reports via a LangGraph.js agent, a CI-runnable eval harness, and a typed React 19 + Vite demo UI. TypeScript/Node.js portfolio project.",
  "license": "MIT",
  "author": "Ed Chapman (https://github.com/edjchapman)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edjchapman/ai-due-diligence-assistant.git"
  },
  "homepage": "https://app-production-e60e.up.railway.app",
  "bugs": {
    "url": "https://github.com/edjchapman/ai-due-diligence-assistant/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "npm run db:migrate && npm run ingest && npm run start",
    "typecheck": "tsc && tsc -p web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "vite build",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "ingest": "tsx src/ingest.ts",
    "fixtures:pdf": "tsx scripts/generate-pdf-fixtures.ts",
    "demo": "tsx src/demo.ts",
    "eval": "tsx src/eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "build:web": "vite build",
    "dev:web": "vite",
    "pretest": "vite build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/openai": "^4.0.66",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@langchain/langgraph": "^1.4.15",
    "ai": "^7.0.99",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.4",
    "postgres": "^3.4.5",
    "tsx": "^4.23.13",
    "unpdf": "^1.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10"
  }
}
